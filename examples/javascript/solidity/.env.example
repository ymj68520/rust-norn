# Norn blockchain RPC endpoint
NORN_RPC_URL=http://localhost:8545

# Ethereum JSON-RPC endpoint (typically RPC port + 1000)
NORN_ETH_RPC_URL=http://localhost:9545

# Private key for deployment (64 hex chars, no 0x prefix)
PRIVATE_KEY=your_private_key_here

# Chain ID (default: 31337 for testnet)
CHAIN_ID=31337

# Path to compiled contract artifact JSON
CONTRACT_ARTIFACT=./artifacts/SimpleStorage.json

# Path to Solidity source file
SOLIDITY_SOURCE=../contracts/SimpleStorage.sol
